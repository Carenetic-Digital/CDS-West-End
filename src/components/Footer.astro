---
import { clinic } from '../data/clinic';
import { footerServices } from '../data/services';

const year = new Date().getFullYear();
const footerQuickLinks = [
  { label: "About Us", href: "/about/" },
  { label: "New Patients", href: "/new-patients/" },
  { label: "Patient Forms", href: "/new-patients/forms/" },
  { label: "Insurance & Payment", href: "/new-patients/insurance-payment/" },
  { label: "Contact Us", href: "/contact/" },
];
const footerResources = [
  { label: "Careers", href: "/about/careers/" },
  { label: "FAQs", href: "/faq/" },
  { label: "CDCP", href: "/cdcp/" },
  { label: "Dental Tips", href: "/dental-tips/" },
  { label: "Accessibility", href: "/accessibility-statement/" },
];
---

<footer class="bg-[var(--color-brand-primary)] text-[var(--color-text-on-dark)]">
  <div class="container-wide pt-16 pb-8">

    <!-- Top: 4 columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 pb-12 border-b border-white/10 gap-y-10">

      <!-- Col 1: Services -->
      <div class="pr-4 md:pr-8">
        <h3 class="font-body text-sm font-semibold tracking-[0.16em] uppercase text-white mb-2">Services</h3>
        <div class="w-8 h-0.5 bg-[var(--color-brand-accent-soft)] mb-5"></div>
        <ul class="space-y-2">
          {footerServices.map(link => (
            <li>
              <a href={link.href} class="inline-flex items-center gap-1.5 text-[var(--color-text-on-dark-muted)] hover:text-white text-sm py-1 transition-colors">
                <span aria-hidden="true" class="text-[var(--color-brand-accent-soft)]">›</span>
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/services/" class="inline-flex items-center gap-1.5 text-white hover:text-[var(--color-brand-accent-soft)] text-sm font-semibold py-1 transition-colors mt-1">
              All Services →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="pl-4 md:px-8">
        <h3 class="font-body text-sm font-semibold tracking-[0.16em] uppercase text-white mb-2">Quick Links</h3>
        <div class="w-8 h-0.5 bg-[var(--color-brand-accent-soft)] mb-5"></div>
        <ul class="space-y-2">
          {footerQuickLinks.map(link => (
            <li>
              <a href={link.href} class="inline-flex text-[var(--color-text-on-dark-muted)] hover:text-white text-sm py-1 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div class="pr-4 md:px-8">
        <h3 class="font-body text-sm font-semibold tracking-[0.16em] uppercase text-white mb-2">Resources</h3>
        <div class="w-8 h-0.5 bg-[var(--color-brand-accent-soft)] mb-5"></div>
        <ul class="space-y-2">
          {footerResources.map(link => (
            <li>
              <a href={link.href} class="inline-flex text-[var(--color-text-on-dark-muted)] hover:text-white text-sm py-1 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Connect -->
      <div class="pl-4 md:pl-10 overflow-visible">
        <div class="mb-2">
          <h3 class="font-body text-sm font-semibold tracking-[0.16em] uppercase text-white">Connect With Us</h3>
        </div>
        <div class="w-8 h-0.5 bg-[var(--color-brand-accent-soft)] mb-5"></div>

        <!-- Social icons -->
        <div class="flex items-center gap-3 mb-5">
          <!-- Facebook -->
          <a
            href={clinic.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="West End Dental Centre on Facebook"
            class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href={clinic.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="West End Dental Centre on Instagram"
            class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        </div>

        <a href="/" aria-label="West End Dental Centre home" class="inline-block">
          <img
            src="/images/logos/west-end-logo-white.png"
            alt="West End Dental Centre"
            width="372"
            height="372"
            loading="lazy"
            decoding="async"
            class="h-[7rem] w-auto block"
          />
        </a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="pt-6 flex flex-wrap items-center justify-center gap-2 text-xs text-[var(--color-text-on-dark-muted)]">
      <span>© {year} West End Dental Centre. All Rights Reserved.</span>
      <span aria-hidden="true" class="text-white/20">|</span>
      <a href="/privacy/" class="inline-flex py-1 text-white hover:text-[var(--color-brand-accent-soft)] transition-colors">Privacy Policy</a>
      <span aria-hidden="true" class="text-white/20">|</span>
      <a href="/terms/" class="inline-flex py-1 text-white hover:text-[var(--color-brand-accent-soft)] transition-colors">Terms of Use</a>
      <span aria-hidden="true" class="text-white/20">|</span>
      <a href="/accessibility-statement/" class="inline-flex py-1 text-white hover:text-[var(--color-brand-accent-soft)] transition-colors">Accessibility</a>
    </div>

  </div>
</footer>
