---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clinic } from '../data/clinic';

const bookingUrl = clinic.bookingUrl;
---

<BaseLayout
  title="Your Smile, Our Priority | West End Dental Centre"
  description="Family dentistry in Edmonton’s West End. Book online or call (825) 605-4477. Complimentary whitening pen for new patients who complete their first visit."
  showHeader={false}
  showFooter={false}
  showPreFooter={false}
  showMobileBar={true}
  mobileRequestHref="#wedc-booking"
>

  <div class="wedc-topbar">
    <div class="wedc-topbar-inner">
      <p class="wedc-topbar-welcome">New patients welcome!</p>
      <p class="wedc-topbar-hours">9509 156 St NW, Suite #M9, Edmonton <span> | <a href="tel:780-944-2828">780-944-2828</a></span></p>
    </div>
  </div>

  <header class="wedc-landing-header">
    <div class="wedc-landing-header-inner">
      <a href="/" class="wedc-landing-logo" aria-label="West End Dental Centre home">
        <img src={clinic.logo} alt={clinic.name} width="2089" height="520" />
      </a>
      <nav class="wedc-landing-nav" aria-label="Smile page">
        <a href="/about/our-clinic/">About Us</a>
        <a href="/services/">Dental Services</a>
        <a href="/new-patients/">Patient Info</a>
        <a href="/contact/">Contact Us</a>
      </nav>
      <div class="wedc-landing-actions">
        <a href="tel:780-944-2828" class="wedc-landing-phone">780-944-2828</a>
        <a href={bookingUrl} target="_blank" rel="noopener" class="wedc-landing-book">Book Now</a>
      </div>
    </div>
  </header>

<style is:global>

.wedc-topbar {
  background: #1178A6;
  color: #fff;
  font-family: Arial, sans-serif;
  font-size: 14px;
}
.wedc-topbar-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 8px 22px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.wedc-topbar a { color: #fff; text-decoration: none; }
.wedc-topbar-welcome { margin: 0; font-weight: 700; }
.wedc-topbar-hours { margin: 0; }
.wedc-landing-header {
  background: #fff;
  border-bottom: 1px solid #DCEBF1;
  position: sticky;
  top: 0;
  z-index: 50;
  font-family: Arial, sans-serif;
}
.wedc-landing-header-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 14px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.wedc-landing-logo img { height: 52px; width: auto; }
.wedc-landing-nav { display: none; gap: 28px; }
.wedc-landing-nav a {
  color: #333132;
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
@media (min-width: 1024px) {
  .wedc-landing-nav { display: flex; }
}
.wedc-landing-actions { display: flex; align-items: center; gap: 16px; }
.wedc-landing-phone {
  display: none;
  color: #1178A6;
  font-weight: 800;
  text-decoration: none;
  font-size: 18px;
}
@media (min-width: 768px) {
  .wedc-landing-phone { display: inline; }
}
.wedc-landing-book {
  background: #ff0000 !important;
  color: #fff !important;
  font-weight: 800;
  text-transform: uppercase;
  text-decoration: none;
  padding: 12px 22px;
  border-radius: 7px;
}
.wedc-landing-footer {
  background: #1178A6;
  color: #fff;
  font-family: Arial, sans-serif;
  padding: 48px 22px 24px;
}
.wedc-landing-footer a { color: #fff; }
.wedc-landing-footer-inner {
  max-width: 1180px;
  margin: 0 auto;
  display: grid;
  gap: 28px;
}
@media (min-width: 768px) {
  .wedc-landing-footer-inner { grid-template-columns: 1fr 1fr 1fr; }
}
.wedc-landing-footer-name { font-weight: 800; margin: 0 0 10px; }
.wedc-landing-footer p { margin: 0 0 6px; line-height: 1.5; }
.wedc-landing-copy {
  max-width: 1180px;
  margin: 32px auto 0;
  padding-top: 18px;
  border-top: 1px solid rgba(255,255,255,0.2);
  font-size: 13px;
}

.wedc-hero {
    --wedc-blue: #1599D3;
    --wedc-teal: #1178A6;
    --wedc-charcoal: #333132;
    --wedc-grey: #616264;
    --wedc-border: #DCEBF1;
    --wedc-white: #ffffff;

    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow-x: hidden;

    background: linear-gradient(135deg, #ffffff 0%, #eef9fc 100%);
    padding: 90px 22px;
    font-family: Aileron, Acumin, Arial, sans-serif;
  }

  .wedc-hero * {
    box-sizing: border-box;
  }

  .wedc-hero-container {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }

  .wedc-hero-eyebrow {
    color: var(--wedc-blue);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .wedc-hero-title {
    font-size: clamp(42px, 6vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--wedc-charcoal);
    margin: 0 0 22px;
    font-weight: 900;
  }

  .wedc-hero-text {
    font-size: 18px;
    line-height: 1.6;
    color: var(--wedc-grey);
    margin: 0 0 30px;
    max-width: 560px;
  }

  .wedc-hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .wedc-hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 14px 26px;
    border-radius: 999px;
    font-weight: 900;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .wedc-hero-btn-primary {
    background: var(--wedc-blue);
    color: var(--wedc-white);
    box-shadow: 0 16px 34px rgba(21, 153, 211, 0.22);
  }

  .wedc-hero-btn-primary:hover {
    background: var(--wedc-teal);
    color: var(--wedc-white);
  }

  .wedc-hero-btn-secondary {
    background: var(--wedc-white);
    color: var(--wedc-charcoal);
    border: 1px solid var(--wedc-border);
  }

  .wedc-hero-btn-secondary:hover {
    border-color: var(--wedc-blue);
    color: var(--wedc-blue);
  }

  .wedc-hero-image-card {
    background: var(--wedc-white);
    border: 1px solid var(--wedc-border);
    border-radius: 34px;
    padding: 16px;
    box-shadow: 0 28px 80px rgba(51, 49, 50, 0.12);
  }

  .wedc-hero-image {
    width: 100%;
    min-height: 560px;
    border-radius: 24px;
    background-image: url("/images/smile/Dr-Wong-Patient.png");
    background-size: cover;
    background-position: center;
  }

  @media (max-width: 900px) {
    .wedc-hero {
      padding: 70px 20px;
    }

    .wedc-hero-container {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .wedc-hero-text {
      max-width: none;
    }

    .wedc-hero-image {
      min-height: 420px;
    }
  }

  @media (max-width: 640px) {
    .wedc-hero {
      padding: 58px 18px;
    }

    .wedc-hero-title {
      font-size: 43px;
    }

    .wedc-hero-buttons {
      flex-direction: column;
    }

    .wedc-hero-btn {
      width: 100%;
    }

    .wedc-hero-image-card {
      border-radius: 26px;
      padding: 10px;
    }

    .wedc-hero-image {
      min-height: 340px;
      border-radius: 20px;
    }
  }

.wedc-location-block {
    --wedc-blue: #1599D3;
    --wedc-teal: #1178A6;
    --wedc-charcoal: #333132;
    --wedc-grey: #616264;
    --wedc-light-grey: #F5F8FA;
    --wedc-border: #DCEBF1;
    --wedc-white: #ffffff;

    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow-x: hidden;

    background: var(--wedc-light-grey);
    padding: 80px 22px;
    font-family: Aileron, Acumin, Arial, sans-serif;
    color: var(--wedc-charcoal);
  }

  .wedc-location-block * {
    box-sizing: border-box;
  }

  .wedc-location-container {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
    align-items: stretch;
  }

  .wedc-info-card {
    background: var(--wedc-white);
    border: 1px solid var(--wedc-border);
    border-radius: 34px;
    padding: 44px;
    box-shadow: 0 18px 50px rgba(51, 49, 50, 0.07);
  }

  .wedc-location-eyebrow {
    color: var(--wedc-blue);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .wedc-location-title {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--wedc-charcoal);
    margin: 0 0 22px;
    font-weight: 900;
  }

  .wedc-location-text {
    font-size: 18px;
    line-height: 1.6;
    color: var(--wedc-grey);
    margin: 0 0 28px;
  }

  .wedc-address-box {
    background: #F8FCFE;
    border: 1px solid var(--wedc-border);
    border-radius: 22px;
    padding: 24px;
    margin-bottom: 24px;
  }

  .wedc-address-label {
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wedc-blue);
    margin-bottom: 8px;
  }

  .wedc-address {
    font-size: 20px;
    line-height: 1.45;
    font-weight: 800;
    color: var(--wedc-charcoal);
    margin: 0;
  }

  .wedc-phone-link {
    display: inline-block;
    color: var(--wedc-blue);
    font-size: 22px;
    font-weight: 900;
    text-decoration: none;
    margin: 4px 0 26px;
  }

  .wedc-feature-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0 0 30px;
  }

  .wedc-feature-pill {
    background: var(--wedc-white);
    border: 1px solid var(--wedc-border);
    border-radius: 999px;
    padding: 12px 16px;
    color: var(--wedc-charcoal);
    font-size: 15px;
    font-weight: 850;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .wedc-feature-pill svg {
    width: 20px;
    height: 20px;
    color: var(--wedc-blue);
    flex: 0 0 20px;
  }

  .wedc-location-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .wedc-location-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 14px 26px;
    border-radius: 999px;
    font-weight: 900;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .wedc-location-btn-primary {
    background: var(--wedc-blue);
    color: var(--wedc-white);
    box-shadow: 0 16px 34px rgba(21, 153, 211, 0.22);
  }

  .wedc-location-btn-primary:hover {
    background: var(--wedc-teal);
    color: var(--wedc-white);
  }

  .wedc-location-btn-secondary {
    background: var(--wedc-white);
    color: var(--wedc-charcoal);
    border: 1px solid var(--wedc-border);
  }

  .wedc-location-btn-secondary:hover {
    border-color: var(--wedc-blue);
    color: var(--wedc-blue);
  }

  .wedc-frontage-card {
    min-height: 520px;
    border-radius: 34px;
    border: 1px solid var(--wedc-border);
    box-shadow: 0 18px 50px rgba(51, 49, 50, 0.08);
    background-image:
      linear-gradient(rgba(51, 49, 50, 0.02), rgba(51, 49, 50, 0.16)),
      url("/images/smile/West-End-Dental-Back-of-Clinic.png");
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
  }

  .wedc-frontage-overlay {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(10px);
    border-radius: 22px;
    padding: 20px 22px;
    box-shadow: 0 16px 40px rgba(51, 49, 50, 0.12);
  }

  .wedc-frontage-overlay strong {
    display: block;
    font-size: 20px;
    line-height: 1.15;
    color: var(--wedc-charcoal);
    margin-bottom: 5px;
  }

  .wedc-frontage-overlay span {
    display: block;
    color: var(--wedc-grey);
    font-size: 15px;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .wedc-location-container {
      grid-template-columns: 1fr;
    }

    .wedc-frontage-card {
      min-height: 420px;
    }
  }

  @media (max-width: 640px) {
    .wedc-location-block {
      padding: 58px 18px;
    }

    .wedc-info-card {
      padding: 30px;
      border-radius: 26px;
    }

    .wedc-feature-list {
      grid-template-columns: 1fr;
    }

    .wedc-location-buttons {
      flex-direction: column;
    }

    .wedc-location-btn {
      width: 100%;
    }

    .wedc-frontage-card {
      min-height: 360px;
      border-radius: 26px;
    }

    .wedc-frontage-overlay {
      left: 18px;
      right: 18px;
      bottom: 18px;
      border-radius: 18px;
    }
  }

.wedc-smile-block {
    --wedc-blue: #1599D3;
    --wedc-light-blue: #C0DFF0;
    --wedc-teal: #1178A6;
    --wedc-charcoal: #333132;
    --wedc-grey: #616264;
    --wedc-soft-bg: #F5F8FA;
    --wedc-border: #DCEBF1;
    --wedc-white: #ffffff;

    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow-x: hidden;

    background: #ffffff;
    padding: 86px 22px;
    font-family: Aileron, Acumin, Arial, sans-serif;
    color: var(--wedc-charcoal);
  }

  .wedc-smile-block * {
    box-sizing: border-box;
  }

  .wedc-smile-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .wedc-smile-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 38px;
  }

  .wedc-smile-title {
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--wedc-charcoal);
    margin: 0 0 14px;
    font-weight: 900;
  }

  .wedc-smile-subtitle {
    font-size: 18px;
    line-height: 1.6;
    color: var(--wedc-grey);
    margin: 0;
  }

  .wedc-smile-subtitle strong {
    color: var(--wedc-blue);
    font-weight: 900;
  }

  .wedc-booking-row {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(330px, 0.88fr);
    gap: 30px;
    align-items: stretch;
  }

  .wedc-form-card {
    background: #f3f6f8;
    border: 1px solid #e3ebef;
    border-radius: 28px;
    padding: 18px;
    box-shadow: 0 18px 55px rgba(51, 49, 50, 0.06);
    overflow: hidden;
  }

  .wedc-form-card iframe {
    display: block;
    width: 100%;
    border-radius: 18px;
    background: transparent;
  }

  .wedc-offer-card {
    background:
      radial-gradient(circle at top right, rgba(21, 153, 211, 0.14), transparent 36%),
      linear-gradient(135deg, #ffffff 0%, #eef9fc 100%);
    border: 1px solid var(--wedc-border);
    border-top: 5px solid var(--wedc-blue);
    border-radius: 28px;
    padding: 30px;
    box-shadow: 0 18px 55px rgba(51, 49, 50, 0.08);
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .wedc-offer-eyebrow {
    color: var(--wedc-blue);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .wedc-offer-title {
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--wedc-charcoal);
    margin: 0 0 18px;
    font-weight: 900;
  }

  .wedc-offer-text {
    color: var(--wedc-grey);
    font-size: 16px;
    line-height: 1.65;
    margin: 0 0 20px;
  }

  .wedc-promo-box {
    display: inline-block;
    align-self: flex-start;
    background: var(--wedc-blue);
    color: #ffffff;
    border-radius: 14px;
    padding: 13px 18px;
    margin: 0 0 22px;
    box-shadow: 0 14px 28px rgba(21, 153, 211, 0.22);
  }

  .wedc-promo-label {
    display: block;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 3px;
  }

  .wedc-promo-code {
    display: block;
    font-size: 24px;
    line-height: 1;
    font-weight: 900;
  }

  .wedc-offer-list {
    display: grid;
    gap: 10px;
    margin: 0 0 24px;
  }

  .wedc-offer-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--wedc-charcoal);
    font-size: 15px;
    line-height: 1.45;
    font-weight: 750;
  }

  .wedc-offer-item svg {
    width: 19px;
    height: 19px;
    color: var(--wedc-blue);
    flex: 0 0 19px;
    margin-top: 1px;
  }

  .wedc-offer-image {
    width: 100%;
    min-height: 360px;
    flex: 1;
    border-radius: 22px;
    border: 1px solid var(--wedc-border);
    background-image:
      linear-gradient(rgba(51, 49, 50, 0.02), rgba(51, 49, 50, 0.06)),
      url("/images/smile/West-End-Complimentary-Dental-Whitening-Pen.png");
    background-size: cover;
    background-position: center;
    margin-top: 4px;
  }

  .wedc-offer-note {
    color: var(--wedc-grey);
    font-size: 12px;
    line-height: 1.45;
    margin: 16px 0 0;
  }

  @media (max-width: 980px) {
    .wedc-booking-row {
      grid-template-columns: 1fr;
    }

    .wedc-offer-card {
      max-width: 680px;
      margin: 0 auto;
    }

    .wedc-offer-image {
      min-height: 360px;
    }
  }

  @media (max-width: 640px) {
    .wedc-smile-block {
      padding: 64px 18px;
    }

    .wedc-smile-header {
      text-align: left;
      margin-bottom: 28px;
    }

    .wedc-form-card {
      padding: 12px;
      border-radius: 22px;
    }

    .wedc-offer-card {
      padding: 24px;
      border-radius: 22px;
    }

    .wedc-offer-image {
      min-height: 320px;
      border-radius: 18px;
    }
  }

.wedc-invisalign-block {
    --wedc-blue: #1599D3;
    --wedc-light-blue: #C0DFF0;
    --wedc-teal: #1178A6;
    --wedc-charcoal: #333132;
    --wedc-grey: #616264;
    --wedc-soft-bg: #EEF9FC;
    --wedc-border: #DCEBF1;
    --wedc-white: #ffffff;

    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow-x: hidden;

    background: #ffffff;
    padding: 86px 22px;
    font-family: Aileron, Acumin, Arial, sans-serif;
    color: var(--wedc-charcoal);
  }

  .wedc-invisalign-block * {
    box-sizing: border-box;
  }

  .wedc-invisalign-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .wedc-invisalign-card {
    background:
      radial-gradient(circle at top right, rgba(21, 153, 211, 0.12), transparent 34%),
      linear-gradient(135deg, #f2fbfd 0%, #eaf7fa 100%);
    border: 1px solid var(--wedc-border);
    border-radius: 34px;
    padding: 54px;
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: 48px;
    align-items: center;
    box-shadow: 0 18px 55px rgba(51, 49, 50, 0.06);
  }

  .wedc-invisalign-eyebrow {
    color: var(--wedc-blue);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .wedc-invisalign-title {
    font-size: clamp(42px, 5.8vw, 68px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: var(--wedc-charcoal);
    margin: 0 0 24px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .wedc-invisalign-title span {
    color: var(--wedc-blue);
    display: block;
  }

  .wedc-invisalign-text {
    color: var(--wedc-grey);
    font-size: 18px;
    line-height: 1.65;
    margin: 0 0 34px;
    max-width: 520px;
  }

  .wedc-invisalign-list {
    display: grid;
    gap: 0;
    max-width: 540px;
  }

