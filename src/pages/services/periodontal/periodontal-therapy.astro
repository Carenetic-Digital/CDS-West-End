---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const siblingServices = [
  { name: "Periodontal Therapy", href: "/services/periodontal/periodontal-therapy/", current: true },
  { name: "Gum Disease Treatment", href: "/services/periodontal/gum-disease/" },
];
---

<BaseLayout
  title="Periodontal Therapy | Periodontal Care | West End Dental Centre Edmonton"
  description="Scaling and root planing (deep cleaning) at West End Dental Centre in West Edmonton to treat gum disease below the gumline."
>

  <section class="bg-[var(--color-brand-primary)] relative overflow-hidden">
    <div class="hidden lg:block absolute right-0 top-0 bottom-0 w-[50%] pointer-events-none" aria-hidden="true">
      <img
        src="/images/west-end/hero-periodontal.jpg"
        alt="Periodontal Therapy at West End Dental Centre"
        width="1536"
        height="1024"
        loading="eager"
          fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover"
      />
      <div class="hero-image-fade" aria-hidden="true"></div>
    </div>
    <div class="container-wide relative py-16 lg:py-24 lg:max-w-[48%]">
      <nav class="flex items-center gap-2 text-xs text-[var(--color-text-on-dark-muted)] mb-5" aria-label="Breadcrumb">
        <a href="/" class="text-white hover:text-white/80 transition-colors">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/services/" class="text-white/80 hover:text-white transition-colors">Services</a>
        <span aria-hidden="true">›</span>
        <a href="/services/periodontal/" class="text-white/80 hover:text-white transition-colors">Periodontal Care</a>
        <span aria-hidden="true">›</span>
        <span class="text-white">Periodontal Therapy</span>
      </nav>
      <p class="eyebrow text-white">Periodontal Care</p>
      <h1 class="mt-3 font-display font-semibold text-[length:var(--text-5xl)] leading-tight text-white max-w-2xl">
        Periodontal Therapy
      </h1>
      <p class="mt-4 text-lg text-[var(--color-text-on-dark-muted)] leading-relaxed max-w-xl">
        A deep cleaning that removes bacteria and tartar below the gumline to help treat gum disease and support healthier supporting tissues.
      </p>
    </div>
  </section>

  <section class="section-y bg-white">
    <div class="container-wide">
      <div class="grid lg:grid-cols-[1fr_300px] gap-12">
        <div class="space-y-10">
          <div>
            <h2 class="font-display font-semibold text-[length:var(--text-3xl)] text-[var(--color-brand-primary)] mb-4">
              What is scaling and root planing?
            </h2>
            <div class="space-y-4 text-[var(--color-text)] leading-relaxed">
              <p>
                Scaling and root planing is a non-surgical periodontal therapy used when inflammation and deposits extend below the gumline. Scaling removes plaque and tartar from tooth surfaces and pockets; root planing smooths root surfaces so gums can reattach more effectively and bacteria are less likely to accumulate.
              </p>
              <p>
                It is often recommended when a routine cleaning is not enough to address periodontal disease. Treatment may be completed in sections of the mouth over one or more visits, depending on severity.
              </p>
            </div>
          </div>

          <div>
            <h2 class="font-display font-semibold text-[length:var(--text-3xl)] text-[var(--color-brand-primary)] mb-4">
              Aftercare and maintenance
            </h2>
            <div class="space-y-4 text-[var(--color-text)] leading-relaxed">
              <p>
                After scaling and root planing, gum tissues typically need time to heal. Your dentist or hygienist will review home care, sensitivity expectations, and a maintenance schedule. Ongoing periodontal cleanings are often important to keep disease from returning.
              </p>
              <p>
                We explain findings from your periodontal assessment so you understand pocket depths, bleeding, and the goals of therapy before treatment begins.
              </p>
            </div>
          </div>
        </div>

        <aside class="space-y-6">
          <div class="bg-[var(--color-brand-primary)] rounded-2xl p-6 text-white">
            <h3 class="font-display font-semibold text-lg text-white">Ready to Book?</h3>
            <p class="mt-2 text-sm text-[var(--color-text-on-dark-muted)]">Call us or book an appointment online.</p>
            <a href="/book/" class="mt-4 btn btn-primary w-full block text-center">Book Appointment</a>
            <a href="tel:+17809442828" class="mt-2 block text-center text-sm text-[var(--color-text-on-dark-muted)] hover:text-white transition-colors">780-944-2828</a>
          </div>
          <div class="bg-[var(--color-surface-cool)] rounded-2xl p-6 border border-[var(--color-border-soft)]">
            <h3 class="font-body text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-primary)] mb-4">Periodontal Care</h3>
            <ul class="space-y-2">
              {siblingServices.map(item => (
                <li>
                  {item.current ? (
                    <span class="flex items-center gap-2 text-sm font-semibold text-[var(--color-brand-accent)]">
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand-accent)] shrink-0" aria-hidden="true"></span>
                      {item.name}
                    </span>
                  ) : (
                    <a href={item.href} class="flex items-center gap-2 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-brand-accent)] transition-colors">
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-border-soft)] shrink-0" aria-hidden="true"></span>
                      {item.name}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-brand-primary)] py-16 text-center">
    <div class="container-wide">
      <h2 class="font-display font-semibold text-[length:var(--text-4xl)] text-white leading-tight">Questions about this treatment?</h2>
      <p class="mt-4 text-[var(--color-text-on-dark-muted)] text-lg max-w-xl mx-auto">Call <a href="tel:+17809442828" class="text-white font-semibold hover:text-[var(--color-brand-accent-soft)] transition-colors">780-944-2828</a> or book an appointment online.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/book/" class="btn btn-primary btn-lg">Book Appointment</a>
        <a href="/contact/" class="btn btn-lg border border-white/30 text-white hover:bg-white/10 transition-colors">Contact Us</a>
      </div>
    </div>
  </section>

</BaseLayout>
