---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const services = [
  {
    title: "Diagnostic Imaging and X-rays",
    href: "/services/diagnostic/x-rays/",
    description: "Digital x-rays help reveal decay between teeth, monitor bone levels, and show anatomy below the gumline so we can diagnose accurately and plan treatment.",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/>`,
  },
];
---

<BaseLayout
  title="Diagnostic Services | West End Dental Centre Edmonton"
  description="Diagnostic dental services at West End Dental Centre in West Edmonton, including digital x-rays and imaging that support accurate treatment planning."
>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="bg-[var(--color-brand-primary)] relative overflow-hidden">
    <!-- Right-side image panel, desktop only -->
    <div class="hidden lg:block absolute right-0 top-0 bottom-0 w-[50%] pointer-events-none" aria-hidden="true">
      <img
        src="/images/west-end/hero-xrays.jpg"
        alt="Diagnostic Services at West End Dental Centre"
        width="800"
        height="600"
        loading="eager"
          fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover"
      />
      <div class="hero-image-fade" aria-hidden="true"></div>
    </div>
    <div class="container-wide relative py-16 lg:py-24 lg:max-w-[48%]">
      <nav class="flex items-center gap-2 text-xs text-[var(--color-text-on-dark-muted)] mb-5" aria-label="Breadcrumb">
        <a href="/" class="text-white hover:text-white/80 transition-colors">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/services/" class="text-white/80 hover:text-white transition-colors">Services</a>
        <span aria-hidden="true">›</span>
        <span class="text-white">Diagnostic Services</span>
      </nav>
      <p class="eyebrow text-white">West End Dental Centre</p>
      <h1 class="mt-3 font-display font-semibold text-[length:var(--text-5xl)] leading-tight text-white max-w-2xl">
        Diagnostic Services
      </h1>
      <p class="mt-4 text-lg text-[var(--color-text-on-dark-muted)] leading-relaxed max-w-xl">
        Accurate diagnosis is the foundation of good dental care. The tools and techniques we use allow us to understand what is happening in your mouth before recommending any treatment.
      </p>
    </div>
  </section>

  <!-- ============================================================
       INTRO + SERVICE CARDS
       ============================================================ -->
  <section class="section-y bg-[var(--color-surface-cool)]">
    <div class="container-wide">

      <!-- Intro paragraph -->
      <div class="max-w-3xl mx-auto text-center mb-14">
        <p class="eyebrow">Our approach</p>
        <h2 class="mt-3 font-display font-semibold text-[length:var(--text-4xl)] leading-tight text-[var(--color-brand-primary)]">
          See what we see
        </h2>
        <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed">
          A thorough visual examination is always the starting point, but many dental conditions develop in places that are not visible to the naked eye, between teeth, below the gumline, or inside the tooth structure itself. Diagnostic imaging and technology allow us to identify concerns earlier, plan treatment with greater accuracy, and share our findings with you clearly. We only recommend diagnostic tools when there is a clinical reason to do so, and we will always explain what we are looking for and why.
        </p>
      </div>

      <!-- Service cards -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(svc => (
          <div class="bg-white rounded-2xl p-6 border border-[var(--color-border-soft)] shadow-md flex flex-col">
            <div class="w-12 h-12 rounded-full bg-[var(--color-brand-primary)] flex items-center justify-center mb-4 shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svc.icon} />
            </div>
            <h3 class="font-display font-semibold text-lg text-[var(--color-brand-primary)] mb-2">{svc.title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{svc.description}</p>
            <a href={svc.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-brand-accent)] hover:text-[var(--color-brand-accent-hover)] transition-colors">
              Learn More
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ============================================================
       ROLE OF DIAGNOSTICS IN DENTAL CARE
       ============================================================ -->
  <section class="section-y bg-white">
    <div class="container-wide">
      <div class="grid lg:grid-cols-[1fr_300px] gap-12">

        <div class="space-y-8">
          <div>
            <h2 class="font-display font-semibold text-[length:var(--text-3xl)] text-[var(--color-brand-primary)] mb-4">
              The role of diagnostic imaging in dental care
            </h2>
            <div class="space-y-4 text-[var(--color-text)] leading-relaxed">
              <p>
                Many dental problems begin in areas that cannot be seen during a standard visual examination. Cavities forming between teeth, infection developing around a root, early bone loss from gum disease, or changes in the anatomy of impacted teeth, these all require imaging to detect and monitor accurately.
              </p>
              <p>
                Diagnostic tools also support more precise treatment. When a dentist can see the exact dimensions of a tooth or the shape of a root canal system, they can plan treatment with greater confidence and predictability.
              </p>
              <p>
                The frequency and type of imaging recommended will vary based on your individual history, age, risk level, and what is being assessed. Diagnostic imaging is always a clinical decision, we discuss the rationale with you before proceeding.
              </p>
            </div>
          </div>

          <div>
            <h2 class="font-display font-semibold text-[length:var(--text-3xl)] text-[var(--color-brand-primary)] mb-4">
              Radiation and safety
            </h2>
            <div class="space-y-4 text-[var(--color-text)] leading-relaxed">
              <p>
                All dental x-rays involve some exposure to ionizing radiation. Digital x-ray systems use significantly less radiation than older film-based systems, typically 70-90% less. We use the lowest exposure that still gives a clear diagnostic image.
              </p>
              <p>
                We follow evidence-based guidelines for imaging frequency and type, and we take into account each patient's individual circumstances. If you have questions about why a particular type of imaging is being recommended, we are happy to discuss it.
              </p>
            </div>
          </div>
        </div>

        <!-- Sidebar: book CTA only -->
        <aside class="space-y-6">
          <div class="bg-[var(--color-brand-primary)] rounded-2xl p-6 text-white">
            <h3 class="font-display font-semibold text-lg text-white">Ready to Book?</h3>
            <p class="mt-2 text-sm text-[var(--color-text-on-dark-muted)]">Call us or book an appointment online, new patients welcome.</p>
            <a href="/book/" class="mt-4 btn btn-primary w-full block text-center">Book Appointment</a>
            <a href="tel:+17809442828" class="mt-2 block text-center text-sm text-[var(--color-text-on-dark-muted)] hover:text-white transition-colors">780-944-2828</a>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- ============================================================
       CTA BAND
       ============================================================ -->
  <section class="bg-[var(--color-brand-primary)] py-16 text-center overflow-hidden relative">
    <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 60 C 240 20, 480 100, 720 60 C 960 20, 1200 100, 1440 60 L1440 160 L0 160 Z" fill="rgba(255,255,255,0.03)"/>
    </svg>
    <div class="relative container-wide">
      <h2 class="font-display font-semibold text-[length:var(--text-4xl)] text-white leading-tight">Ready to get started?</h2>
      <p class="mt-4 text-[var(--color-text-on-dark-muted)] text-lg max-w-xl mx-auto">Call <a href="tel:+17809442828" class="text-white font-semibold hover:text-[var(--color-brand-accent-soft)] transition-colors">780-944-2828</a> or book an appointment online.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/book/" class="btn btn-primary btn-lg">Book Appointment</a>
        <a href="/contact/" class="btn btn-lg border border-white/30 text-white hover:bg-white/10 transition-colors">Contact Us</a>
      </div>
    </div>
  </section>

</BaseLayout>
