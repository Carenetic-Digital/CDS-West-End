---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Dental Tips | West End Dental Centre"
  description="Practical dental tips from West End Dental Centre in West Edmonton."
>
  <section class="bg-[var(--color-brand-primary)]">
    <div class="container-wide py-16 lg:py-20">
      <p class="eyebrow text-white">Patient Education</p>
      <h1 class="mt-3 font-display font-semibold text-[length:var(--text-5xl)] leading-tight text-white max-w-2xl">
        Dental Tips
      </h1>
      <p class="mt-4 text-lg text-white/90 max-w-xl leading-relaxed">
        Helpful information for keeping your smile healthy between visits.
      </p>
    </div>
  </section>

  <section class="section-y bg-white">
    <div class="container-wide">
      {posts.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <article class="flex flex-col rounded-2xl overflow-hidden border border-[var(--color-border-soft)] bg-white shadow-sm">
              {post.data.featuredImage.src && (
                <a href={`/dental-tips/${post.id}/`} tabindex="-1" aria-hidden="true">
                  <img
                    src={post.data.featuredImage.src}
                    alt={post.data.featuredImage.alt}
                    width="1200"
                    height="630"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-48 object-cover"
                  />
                </a>
              )}
              <div class="p-6 flex flex-col flex-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-brand-accent)]">
                  {post.data.category}
                </p>
                <h2 class="mt-2 font-display font-semibold text-xl leading-snug text-[var(--color-brand-primary)]">
                  <a href={`/dental-tips/${post.id}/`} class="hover:underline">{post.data.title}</a>
                </h2>
                <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">
                  {post.data.description}
                </p>
                <p class="mt-4 text-xs text-[var(--color-text-muted)]">
                  <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
                  {post.data.readTime && <span> · {post.data.readTime}</span>}
                </p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-[var(--color-text)] leading-relaxed">
          New articles are on the way. In the meantime, call us at
          <a href="tel:+17809442828" class="font-semibold text-[var(--color-brand-primary)]">780-944-2828</a>
          with any questions.
        </p>
      )}

      <p class="mt-12 text-[var(--color-text)] leading-relaxed">
        Looking for something specific? Call us at
        <a href="tel:+17809442828" class="font-semibold text-[var(--color-brand-primary)]">780-944-2828</a>
        or explore our
        <a href="/services/" class="font-semibold text-[var(--color-brand-primary)]">dental services</a>.
      </p>
    </div>
  </section>
</BaseLayout>
