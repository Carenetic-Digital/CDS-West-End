---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { clinic } from '../../data/clinic';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;

const siteURL = Astro.site ?? new URL('https://www.westenddentalcentre.com/');
const pageURL = new URL(`/dental-tips/${post.id}/`, siteURL).href;
const imageURL = data.featuredImage.src ? new URL(data.featuredImage.src, siteURL).href : undefined;

const dateFmt = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const related = (await getCollection('blog', ({ data: d }) => !d.draft))
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={`${data.title} | West End Dental Centre`}
  description={data.description}
  image={data.featuredImage.src || undefined}
  schemas={[
    {
      type: 'BlogPosting',
      data: {
        headline: data.title,
        description: data.description,
        datePublished: data.date.toISOString(),
        mainEntityOfPage: pageURL,
        url: pageURL,
        ...(imageURL ? { image: imageURL } : {}),
        author: { '@id': `${new URL('/', siteURL).href}#organization` },
        publisher: { '@id': `${new URL('/', siteURL).href}#organization` },
      },
    },
  ]}
>
  <!-- ===================== HERO ===================== -->
  <section class="bg-[var(--color-brand-primary)]">
    <div class="container-wide py-14 lg:py-16">
      <nav aria-label="Breadcrumb" class="text-sm text-white/80">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2" aria-hidden="true">›</span>
        <a href="/dental-tips/" class="hover:text-white transition-colors">Dental Tips</a>
      </nav>
      <p class="mt-6 eyebrow text-white">{data.category}</p>
      <h1 class="mt-3 font-display font-semibold text-[length:var(--text-5xl)] leading-tight text-white max-w-3xl">
        {data.title}
      </h1>
      <p class="mt-4 text-sm text-white/80">
        <time datetime={data.date.toISOString()}>{dateFmt.format(data.date)}</time>
        {data.readTime && <span> · {data.readTime}</span>}
      </p>
    </div>
  </section>

  <!-- ===================== ARTICLE ===================== -->
  <section class="section-y bg-white">
    <div class="container-narrow">
      {data.featuredImage.src && (
        <img
          src={data.featuredImage.src}
          alt={data.featuredImage.alt}
          width="1200"
          height="630"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full rounded-2xl mb-10 object-cover"
        />
      )}
      {data.headline && (
        <h2 class="font-display font-semibold text-[length:var(--text-3xl)] leading-tight text-[var(--color-brand-primary)] mb-6">
          {data.headline}
        </h2>
      )}
      <div class="post-body" set:html={data.body} />

      <!-- CTA -->
      <div class="mt-12 rounded-2xl bg-[var(--color-surface-cool)] border border-[var(--color-border-soft)] p-6 sm:p-8">
        <h2 class="font-display font-semibold text-[length:var(--text-2xl)] text-[var(--color-brand-primary)]">
          Questions about your oral health?
        </h2>
        <p class="mt-3 text-[var(--color-text-muted)] leading-relaxed">
          Our team is happy to help. Book an appointment online or call us at
          <a href={`tel:${clinic.phoneTel}`} class="font-semibold text-[var(--color-brand-primary)]">{clinic.phoneDisplay}</a>.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/book/" class="btn btn-primary">Book Appointment</a>
          <a href="/contact/" class="btn btn-outline">Contact Us</a>
        </div>
      </div>

      {related.length > 0 && (
        <div class="mt-12">
          <h2 class="font-display font-semibold text-[length:var(--text-2xl)] text-[var(--color-brand-primary)] mb-5">
            More dental tips
          </h2>
          <ul class="space-y-3">
            {related.map(p => (
              <li>
                <a href={`/dental-tips/${p.id}/`} class="font-semibold text-[var(--color-brand-primary)] hover:underline">
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <p class="mt-12">
        <a href="/dental-tips/" class="font-semibold text-[var(--color-brand-primary)] hover:underline">← Back to Dental Tips</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .post-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-2xl);
    line-height: 1.25;
    color: var(--color-brand-primary);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .post-body :global(p) {
    color: var(--color-text);
    line-height: 1.75;
    margin-bottom: 1.125rem;
  }
  .post-body :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .post-body :global(li) {
    color: var(--color-text);
    line-height: 1.75;
    margin-bottom: 0.5rem;
  }
  .post-body :global(a) {
    color: var(--color-brand-primary);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
